includes:
    - phpstan-baseline.neon

parameters:
    level: 5
    paths:
        - src
    # The optional Livewire UI is the presentation layer: it requires the host's
    # Flux peer dependency and references a package-namespaced Blade view that
    # Larastan cannot resolve to a `view-string` in isolation. Its logic is
    # covered by the Livewire feature tests.
    excludePaths:
        - src/Livewire/SsoProviders.php
    tmpDir: build/phpstan
